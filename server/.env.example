# Server
PORT=4000
NODE_ENV=development

# Neon Postgres — paste your connection string from https://console.neon.tech
# Use the pooled connection string (ends with -pooler) for the API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: CORS origin for the Vite frontend
CORS_ORIGIN=http://localhost:5173

# Auth — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Public frontend origin used when generating invite links (no trailing slash)
APP_PUBLIC_URL=http://localhost:5173/real
